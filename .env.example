# Environment Variables for DevFolio OS
# Copy this file to .env and fill in your values

# ─── Auth / Security ────────────────────────────────────────────────────────────
# Generate a secure random string for production
SECRET_KEY=supersecretkey_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=False
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ─── Database & Redis (Docker handles defaults, but you can override) ───────────
DATABASE_URL=postgresql+asyncpg://devfolio_user:devfolio_password@db:5432/devfolio_db
REDIS_URL=redis://redis:6379/0

# ─── GitHub OAuth Integration ───────────────────────────────────────────────────
# Register OAuth App at: https://github.com/settings/developers
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:8000/api/users/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ─── AI Providers ───────────────────────────────────────────────────────────────
# Google Gemini API Key (used by backend for AI Advisor/Roadmaps)
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
